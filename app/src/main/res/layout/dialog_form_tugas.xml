<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Tugas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="16dp"/>

        <EditText android:id="@+id/in_judul" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Judul Tugas (Wajib)"/>
        <EditText android:id="@+id/in_matpel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mata Kuliah (Wajib)"/>
        <EditText
            android:id="@+id/in_deadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pilih Deadline (Wajib)"
            android:drawableEnd="@android:drawable/ic_menu_today"
            android:focusable="false"
            android:clickable="true"/>

        <EditText android:id="@+id/in_deskripsi" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Deskripsi Singkat"/>
        <EditText
            android:id="@+id/in_instruksi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Instruksi Pengerjaan"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"/>
        <EditText android:id="@+id/in_format" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Format (Contoh: PDF)"/>
        <EditText android:id="@+id/in_ketentuan" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ketentuan Lain"/>
        <EditText android:id="@+id/in_pengajar" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nama Dosen"/>

        <Button
            android:id="@+id/btn_simpan_dialog"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Simpan"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>