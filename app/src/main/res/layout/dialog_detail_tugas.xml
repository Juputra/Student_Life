<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView android:id="@+id/det_matpel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mata Kuliah" android:textStyle="bold" android:textColor="#6200EE" android:textSize="14sp"/>
    <TextView android:id="@+id/det_judul" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Judul Tugas" android:textStyle="bold" android:textSize="22sp" android:textColor="#111827" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/det_deadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Deadline" android:textColor="#EF4444" android:textSize="14sp" android:layout_marginTop="4dp"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginVertical="16dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Deskripsi:" android:textStyle="bold" android:textColor="#4B5563"/>
    <TextView android:id="@+id/det_deskripsi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Isi deskripsi" android:layout_marginTop="2dp" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Instruksi Pengerjaan:" android:textStyle="bold" android:textColor="#4B5563"/>
    <TextView android:id="@+id/det_instruksi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Isi instruksi" android:layout_marginTop="2dp" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Format Pengumpulan:" android:textStyle="bold" android:textColor="#4B5563"/>
    <TextView android:id="@+id/det_format" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Isi format" android:layout_marginTop="2dp" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ketentuan Tambahan:" android:textStyle="bold" android:textColor="#4B5563"/>
    <TextView android:id="@+id/det_ketentuan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Isi ketentuan" android:layout_marginTop="2dp" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dosen Pengajar:" android:textStyle="bold" android:textColor="#4B5563"/>
    <TextView android:id="@+id/det_pengajar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nama dosen" android:layout_marginTop="2dp"/>
</LinearLayout>