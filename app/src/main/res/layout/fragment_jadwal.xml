<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fitur Jadwal Kuliah"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_hari"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Hari (ex: Senin)"/>

        <Button
            android:id="@+id/btn_lihat_hari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lihat Data"/>
    </LinearLayout>

    <EditText
        android:id="@+id/input_matpel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mata Pelajaran (ex: Pemrograman Android)"/>

    <EditText
        android:id="@+id/input_ruangan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ruangan (ex: Lab Komputer A)"/>

    <EditText
        android:id="@+id/input_catatan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Catatan (ex: Bawa laptop)"/>

    <Button
        android:id="@+id/btn_simpan_jadwal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tambah Jadwal"
        android:layout_marginTop="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#E5E7EB"
        android:layout_marginVertical="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_jadwal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>